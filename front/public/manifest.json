{
  "manifest_version": 3,
  "name": "MindBuddy",
  "version": "1.0.0",
  "description": "Detect and highlight toxic sentences on Facebook",
  "author": "ThinkAI",
  "action": {
    "default_popup": "index.html",
    "default_title": "MindBuddy"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}